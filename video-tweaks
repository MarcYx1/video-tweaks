#!/usr/bin/python3
"""Video Tweaks: trim a video, compress it to a target size and/or mix its audio tracks into one."""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

DCOMP = Path(__file__).resolve().parent / "dcomp"
# RNNoise speech model: next to the script in the repo, or where install.sh puts it
MODEL = next((p for p in (Path(__file__).resolve().parent / "models" / "sh.rnnn",
                          Path.home() / ".local/share/video-tweaks/sh.rnnn") if p.exists()), None)
TIME_RE = re.compile(r"time=(\d+):(\d+):([\d.]+)")


# ---------- engine (no GTK) ----------

def probe(path):
    """Return (duration in s, list of audio track titles)."""
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries",
         "format=duration:stream=codec_type:stream_tags=title", "-of", "json", path],
        capture_output=True, text=True, check=True).stdout
    d = json.loads(out)
    titles = [s.get("tags", {}).get("title", "") for s in d["streams"] if s["codec_type"] == "audio"]
    return float(d["format"].get("duration") or 0), titles


def find_mic(titles):
    """Index of the first track that looks like a microphone, or None."""
    return next((i for i, t in enumerate(titles)
                 if re.search(r"mic|input", t, re.I) and "Monitor of" not in t), None)


def keyframe_before(src, t):
    """Time of the last video keyframe at or before t. A copy cut that starts exactly there has
    no hidden lead-in frames; VLC freezes and smears on those."""
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "packet=pts_time,flags",
         "-read_intervals", f"{max(t - 30, 0)}%{t + 0.001}", "-of", "csv=p=0", src],
        capture_output=True, text=True, check=True).stdout
    keys = [float(p) for p, f, *_ in (l.split(",") for l in out.split())
            if "K" in f and p != "N/A" and float(p) <= t + 0.001]
    return max(keys, default=t)


def mix_cmd(src, tracks, dst, denoise=None, trim=None, volumes=None):
    """Mix the chosen audio tracks into one; track `denoise` (if any) goes through RNNoise first.
    volumes={track: factor}. trim=(start, end) in s; video is copied, so start should be a keyframe."""
    vol = volumes or {}

    def chain(i):
        # ponytail: model path is single-quoted, breaks if it contains a ' (install path never does)
        # aeval: arnndn leaves garbage (NaN or huge values) in the last partial frame at end of stream,
        # which makes aac fail; zero anything that is NaN or beyond +-2 (real audio stays within +-1)
        f = [f"highpass=f=80,arnndn=m='{MODEL}',"
             "aeval=exprs='if(isnan(val(ch))+gt(abs(val(ch)),2),0,val(ch))':c=same"] if i == denoise else []
        return ",".join(f + ([f"volume={vol[i]}"] if vol.get(i, 1) != 1 else []))

    if len(tracks) == 1 and not chain(tracks[0]):
        audio = ["-map", f"0:a:{tracks[0]}", "-c:a", "copy"]
    else:
        pre = "".join(f"[0:a:{i}]{chain(i)}[d{i}];" for i in tracks if chain(i))
        ins = "".join(f"[d{i}]" if chain(i) else f"[0:a:{i}]" for i in tracks)
        graph = pre + ins + f"amix=inputs={len(tracks)}:normalize=0[a]"
        audio = ["-filter_complex", graph, "-map", "[a]", "-c:a", "aac", "-b:a", "192k"]
    cut = ["-ss", str(trim[0]), "-to", str(trim[1])] if trim else []
    return ["ffmpeg", "-hide_banner", "-y", *cut, "-i", src, "-map", "0:v:0?", *audio,
            "-c:v", "copy", "-movflags", "+faststart", dst]


def plan(src, track_count, tracks, only_mix, mb, out_dir, tmp, denoise=None, trim=None, volumes=None):
    """Return (output path, steps). A step is (weight, argv, is_dcomp). trim=(start, end) in s or None."""
    stem = Path(src).stem
    mixing = len(tracks) > 1 or denoise is not None or bool(volumes)
    tag = ("trimmed" if trim and not mixing else "mixed") if only_mix else f"{mb}mb"
    out = str(Path(out_dir) / f"{stem}_{tag}.mp4")
    if only_mix:
        if trim:
            trim = (keyframe_before(src, trim[0]), trim[1])
        return out, [(1.0, mix_cmd(src, tracks, out, denoise, trim, volumes), False)]
    cut = [str(trim[0]), str(trim[1])] if trim else []  # dcomp cuts exact, the mix step does not cut
    if track_count > 1 or mixing:  # dcomp keeps one audio track as is: mix/filter first
        mixed = os.path.join(tmp, "mixed.mp4")
        return out, [(0.1, mix_cmd(src, tracks, mixed, denoise, volumes=volumes), False),
                     (0.9, [str(DCOMP), mixed, str(mb), out, *cut], True)]
    return out, [(1.0, [str(DCOMP), src, str(mb), out, *cut], True)]


class Job:
    """Runs the steps one after another. Callbacks are called from the worker thread."""

    def __init__(self, steps, duration, env, on_line, on_progress):
        self.steps, self.duration, self.env = steps, duration, env
        self.on_line, self.on_progress = on_line, on_progress
        self.proc, self.cancelled = None, False

    def run(self):
        done = 0.0
        for weight, argv, is_dcomp in self.steps:
            if self.cancelled:
                return -signal.SIGKILL
            self.proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                         start_new_session=True, env=self.env)
            ffpass, buf = 1, b""
            while chunk := os.read(self.proc.stdout.fileno(), 4096):
                *lines, buf = re.split(rb"[\r\n]", buf + chunk)
                for raw in lines:
                    line = raw.decode(errors="replace")
                    if not line.strip():
                        continue
                    self.on_line(line)
                    if line.startswith("Output #0, null"):
                        ffpass = 1
                    elif line.startswith("Output #0, mp4"):
                        ffpass = 2
                    m = TIME_RE.search(line)
                    if m and self.duration > 0:
                        t = int(m[1]) * 3600 + int(m[2]) * 60 + float(m[3])
                        part = min(t / self.duration, 1.0)
                        if is_dcomp:
                            part = (ffpass - 1 + part) / 2
                        self.on_progress(min(done + weight * part, 0.99))
            if buf.strip():
                self.on_line(buf.decode(errors="replace"))
            rc = self.proc.wait()
            if rc or self.cancelled:
                return rc or -signal.SIGKILL
            done += weight
        self.on_progress(1.0)
        return 0

    def cancel(self):
        self.cancelled = True
        if self.proc and self.proc.poll() is None:
            # KILL, not TERM: on TERM ffmpeg finalizes and rewrites the output file
            os.killpg(self.proc.pid, signal.SIGKILL)


# ---------- UI ----------

def track_name(title, i):
    title = title.removeprefix("Devices: ").replace("Monitor of ", "")
    return title or f"Track {i + 1}"


def clock(t):
    m, s = divmod(t, 60)
    return f"{int(m):02d}:{s:04.1f}"


def human_size(path):
    n = os.path.getsize(path)
    return f"{n / 1e6:.1f} MB" if n >= 1e6 else f"{n / 1e3:.0f} kB"


def main():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    class Window(Adw.ApplicationWindow):
        def __init__(self, app, path):
            super().__init__(application=app, default_width=560, default_height=900)
            self.path, self.job = path, None
            self.duration, titles = probe(path)
            self.out_dir = str(Path(path).parent)
            self.set_title("Video Tweaks")

            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            view = Adw.ToolbarView(content=self.stack)
            view.add_top_bar(Adw.HeaderBar(title_widget=Adw.WindowTitle(
                title="Video Tweaks", subtitle=Path(path).name)))
            self.set_content(view)

            # settings page
            page = Adw.PreferencesPage()
            # trim: video preview, timeline with start/end handles under it
            self.start_t, self.end_t, self.drag = 0.0, self.duration, None
            self.media = Gtk.MediaFile.new_for_filename(path)
            self.timeline = Gtk.DrawingArea(content_height=36, margin_top=8)
            self.timeline.set_draw_func(self.draw_timeline)
            self.media.connect("notify::timestamp", lambda *_: self.timeline.queue_draw())
            drag = Gtk.GestureDrag()
            drag.connect("drag-begin", self.drag_begin)
            drag.connect("drag-update", self.drag_update)
            self.timeline.add_controller(drag)
            set_start = Gtk.Button(label="Set start", tooltip_text="Start at the playhead", css_classes=["flat"])
            set_start.connect("clicked", lambda *_: self.set_trim(start=self.playhead()))
            set_end = Gtk.Button(label="Set end", tooltip_text="End at the playhead", css_classes=["flat"])
            set_end.connect("clicked", lambda *_: self.set_trim(end=self.playhead()))
            self.trim_label = Gtk.Label(hexpand=True, css_classes=["numeric", "dim-label"])
            row = Gtk.Box(spacing=6, margin_top=4)
            for w in (set_start, self.trim_label, set_end):
                row.append(w)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            for w in (Gtk.Video(media_stream=self.media, height_request=260, css_classes=["card"]),
                      self.timeline, row):
                box.append(w)
            if self.duration > 0:
                trim_group = Adw.PreferencesGroup(title="Trim")
                trim_group.add(box)
                page.add(trim_group)
            self.set_trim()

            group = Adw.PreferencesGroup()
            page.add(group)
            self.only_mix = Adw.SwitchRow(title="Keep original quality",
                                          subtitle="No re-encode: only trim and mix audio")
            self.only_mix.connect("notify::active", self.update)
            group.add(self.only_mix)
            self.size = Adw.SpinRow.new_with_range(1, 500, 1)
            self.size.set_title("Target size")
            self.size.set_subtitle("MB")
            self.size.set_value(8)
            group.add(self.size)
            self.folder_row = Adw.ActionRow(title="Output folder", subtitle=self.out_dir)
            pick = Gtk.Button(icon_name="folder-open-symbolic", valign=Gtk.Align.CENTER,
                              tooltip_text="Choose folder", css_classes=["flat"])
            pick.connect("clicked", self.pick_folder)
            self.folder_row.add_suffix(pick)
            self.folder_row.set_activatable_widget(pick)
            group.add(self.folder_row)

            self.checks, self.vols = [], []
            css = Gtk.CssProvider()  # fixed-width % label, else the slider jumps as the number changes
            css.load_from_string("scale.vol value { min-width: 3.5em; }")
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                       Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.noise = Adw.ComboRow(title="Filter mic noise", subtitle="Removes breathing and background noise",
                                      model=Gtk.StringList.new(["Off", *(track_name(t, i) for i, t in enumerate(titles))]))
            if titles:
                tg = Adw.PreferencesGroup(title="Audio")
                page.add(tg)
            if len(titles) > 1:
                tg.set_title("Audio tracks")
                tg.set_description("Checked tracks are mixed into one")
                for i, t in enumerate(titles):
                    row = Adw.ActionRow(title=track_name(t, i), subtitle=f"Track {i + 1}")
                    cb = Gtk.CheckButton(active=True, valign=Gtk.Align.CENTER)
                    cb.connect("toggled", self.update)
                    row.add_prefix(cb)
                    row.set_activatable_widget(cb)
                    vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 200, 5)
                    vol.set_value(100)
                    vol.add_mark(100, Gtk.PositionType.BOTTOM, None)
                    vol.set_format_value_func(lambda _s, v: f"{v:.0f}%")
                    vol.set_draw_value(True)
                    vol.set_value_pos(Gtk.PositionType.RIGHT)
                    vol.set_size_request(170, -1)
                    vol.set_valign(Gtk.Align.CENTER)
                    vol.set_tooltip_text("Volume")
                    vol.add_css_class("vol")
                    row.add_suffix(vol)
                    tg.add(row)
                    self.checks.append(cb)
                    self.vols.append(vol)
            if titles and MODEL:
                tg.add(self.noise)
                mic = find_mic(titles)
                if mic is not None:
                    self.noise.set_selected(mic + 1)
            self.track_count = len(titles)

            self.go = Gtk.Button(halign=Gtk.Align.CENTER, css_classes=["pill", "suggested-action"])
            self.go.connect("clicked", self.start)
            settings = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            settings.append(page)
            page.set_vexpand(True)
            settings.append(self.wrap(self.go))
            self.stack.add_named(settings, "settings")

            # progress page
            self.status = Gtk.Label(css_classes=["title-4"], wrap=True, xalign=0)
            self.bar = Gtk.ProgressBar(show_text=True)
            self.log = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                    top_margin=8, bottom_margin=8, left_margin=10, right_margin=10)
            self.log_end = self.log.get_buffer().create_mark(None, self.log.get_buffer().get_end_iter(), False)
            scroll = Gtk.ScrolledWindow(child=self.log, vexpand=True, css_classes=["card"])
            self.cancel_btn = Gtk.Button(label="Cancel", css_classes=["pill"])
            self.cancel_btn.connect("clicked", lambda *_: self.job and self.job.cancel())
            self.show_btn = Gtk.Button(label="Show in Files", css_classes=["pill", "suggested-action"])
            self.show_btn.connect("clicked", self.show_in_files)
            self.back_btn = Gtk.Button(label="Back", css_classes=["pill"])
            self.back_btn.connect("clicked", lambda *_: self.stack.set_visible_child_name("settings"))
            buttons = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER)
            for b in (self.cancel_btn, self.back_btn, self.show_btn):
                buttons.append(b)
            prog = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                           margin_top=18, margin_bottom=24, margin_start=18, margin_end=18)
            for w in (self.status, self.bar, scroll, buttons):
                prog.append(w)
            self.stack.add_named(prog, "progress")

            self.connect("close-request", self.on_close)
            self.update()

        def on_close(self, *_):
            if self.job:
                self.job.cancel()
            return False

        def wrap(self, button):
            box = Gtk.Box(halign=Gtk.Align.CENTER, margin_top=12, margin_bottom=24)
            box.append(button)
            return box

        PAD = 8  # timeline side margin, room for the handles

        def t_to_x(self, t, w):
            return self.PAD + t / self.duration * (w - 2 * self.PAD)

        def x_to_t(self, x, w):
            return min(max((x - self.PAD) / (w - 2 * self.PAD), 0), 1) * self.duration

        def playhead(self):
            return self.media.get_timestamp() / 1e6

        def draw_timeline(self, area, cr, w, h):
            fg = area.get_color()
            x0, x1 = self.t_to_x(self.start_t, w), self.t_to_x(self.end_t, w)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.15)  # cut away
            cr.rectangle(self.PAD, 6, w - 2 * self.PAD, h - 12)
            cr.fill()
            sm = Adw.StyleManager.get_default()  # accent colour API is libadwaita 1.6+
            acc = sm.get_accent_color_rgba() if hasattr(sm, "get_accent_color_rgba") else Gdk.RGBA(red=0.21, green=0.52, blue=0.89)
            cr.set_source_rgb(acc.red, acc.green, acc.blue)  # kept
            cr.rectangle(x0, 6, x1 - x0, h - 12)
            cr.fill()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 1)  # handles
            for x in (x0, x1):
                cr.rectangle(x - 3, 0, 6, h)
            cr.fill()
            cr.set_source_rgb(0.88, 0.11, 0.14)  # playhead
            cr.rectangle(self.t_to_x(self.playhead(), w) - 1, 2, 2, h - 4)
            cr.fill()

        def drag_begin(self, g, x, y):
            w = self.timeline.get_width()
            d0, d1 = abs(x - self.t_to_x(self.start_t, w)), abs(x - self.t_to_x(self.end_t, w))
            self.drag = None if min(d0, d1) > 12 else "start" if d0 <= d1 else "end"
            self.drag_update(g, 0, 0)

        def drag_update(self, g, dx, dy):
            _, x, _ = g.get_start_point()
            t = self.x_to_t(x + dx, self.timeline.get_width())
            if self.drag == "start":
                self.set_trim(start=t)
            elif self.drag == "end":
                self.set_trim(end=t)
            else:  # click or drag off the handles moves the playhead
                self.media.seek(int(t * 1e6))

        def set_trim(self, start=None, end=None):
            """Move a handle (clamped, keeps 0.1 s between them) and show that frame."""
            if start is not None:
                self.start_t = min(max(start, 0), self.end_t - 0.1)
                self.media.seek(int(self.start_t * 1e6))
            if end is not None:
                self.end_t = max(min(end, self.duration), self.start_t + 0.1)
                self.media.seek(int(self.end_t * 1e6))
            self.trim_label.set_label(f"{clock(self.start_t)} – {clock(self.end_t)}"
                                      f"  ({self.end_t - self.start_t:.1f} s)")
            self.timeline.queue_draw()

        def trim(self):
            return (round(self.start_t, 3), round(self.end_t, 3)) \
                if self.start_t > 0 or self.end_t < self.duration else None

        def volumes(self):
            return {i: round(v.get_value() / 100, 2) for i, v in enumerate(self.vols) if v.get_value() != 100}

        def selected(self):
            return [i for i, cb in enumerate(self.checks) if cb.get_active()] or [0]

        def update(self, *_):
            mix = self.only_mix.get_active()
            self.size.set_sensitive(not mix)
            self.go.set_label("Save" if mix else "Compress")
            self.go.set_sensitive(not self.checks or any(cb.get_active() for cb in self.checks))

        def pick_folder(self, *_):
            dialog = Gtk.FileDialog(title="Output folder", initial_folder=Gio.File.new_for_path(self.out_dir))

            def done(d, res):
                try:
                    self.out_dir = d.select_folder_finish(res).get_path()
                    self.folder_row.set_subtitle(self.out_dir)
                except GLib.Error:
                    pass  # dialog dismissed
            dialog.select_folder(self, None, done)

        def start(self, *_):
            mb = int(self.size.get_value())
            self.tmp = tempfile.mkdtemp(prefix="video-tweaks.")
            pick, trim = self.noise.get_selected(), self.trim()
            self.media.pause()
            self.out, steps = plan(self.path, self.track_count, self.selected(),
                                   self.only_mix.get_active(), mb, self.out_dir, self.tmp,
                                   pick - 1 if pick > 0 else None, trim, self.volumes())
            self.log.get_buffer().set_text("")
            self.bar.set_fraction(0)
            self.status.set_label(f"Saving {Path(self.out).name}…" if self.only_mix.get_active()
                                  else f"Compressing {Path(self.path).name} to {mb} MB…")
            self.cancel_btn.set_visible(True)
            self.back_btn.set_visible(False)
            self.show_btn.set_visible(False)
            self.stack.set_visible_child_name("progress")
            env = dict(os.environ, TMPDIR=self.tmp)
            self.job = Job(steps, trim[1] - trim[0] if trim else self.duration, env,
                           lambda l: GLib.idle_add(self.add_line, l),
                           lambda f: GLib.idle_add(self.bar.set_fraction, f))
            threading.Thread(target=self.work, daemon=True).start()

        def work(self):
            rc = self.job.run()
            GLib.idle_add(self.finished, rc, self.job.cancelled)

        def add_line(self, line):
            buf = self.log.get_buffer()
            buf.insert(buf.get_end_iter(), line + "\n")
            self.log.scroll_mark_onscreen(self.log_end)

        def finished(self, rc, cancelled):
            self.job = None
            shutil.rmtree(self.tmp, ignore_errors=True)
            self.cancel_btn.set_visible(False)
            self.back_btn.set_visible(True)
            if rc == 0:
                self.bar.set_fraction(1)
                self.status.set_label(f"Done: {Path(self.out).name} ({human_size(self.out)})")
                self.show_btn.set_visible(True)
                return
            Path(self.out).unlink(missing_ok=True)
            if cancelled:
                self.stack.set_visible_child_name("settings")
            else:
                self.status.set_label(f"Failed (exit code {rc}). See the output below.")

        def show_in_files(self, *_):
            Gtk.FileLauncher(file=Gio.File.new_for_path(self.out)).open_containing_folder(self, None, None)

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="io.github.MarcYx1.VideoTweaks",
                             flags=Gio.ApplicationFlags.HANDLES_OPEN)

        def do_open(self, files, n, hint):
            for f in files:
                Window(self, f.get_path()).present()

        def do_activate(self):
            print("usage: video-tweaks <video>...", file=sys.stderr)

    sys.exit(App().run(sys.argv))


if __name__ == "__main__":
    main()
